  {
   "id": "ko_l1_grammar",
   "type": "grammar",
   "title": "Syllable blocks and N이에요/예요",
   "lessons": [
    {
     "id": "ko_l1_grammar_1",
     "title": "Syllable blocks and N이에요/예요",
     "summary": "How Hangul letters combine, and how to say “I am …”.",
     "blocks": [
      {
       "type": "heading",
       "text": "Building syllables"
      },
      {
       "type": "text",
       "text": "Every syllable block has an initial consonant and a vowel, and may have a final consonant (batchim). A syllable that starts with a vowel sound uses the silent ㅇ."
      },
      {
       "type": "table",
       "head": [
        "Parts",
        "Block",
        "Sound"
       ],
       "rows": [
        [
         "ㄱ + ㅏ",
         "가",
         "ga"
        ],
        [
         "ㅇ + ㅗ",
         "오",
         "o"
        ],
        [
         "ㅎ + ㅏ + ㄴ",
         "한",
         "han"
        ],
        [
         "ㄱ + ㅡ + ㄹ",
         "글",
         "geul"
        ],
        [
         "ㅂ + ㅏ + ㅂ",
         "밥",
         "bap"
        ]
       ]
      },
      {
       "type": "heading",
       "text": "N이에요 / N예요 — “(it) is N”"
      },
      {
       "type": "table",
       "head": [
        "Noun ends in",
        "Ending",
        "Example"
       ],
       "rows": [
        [
         "a consonant",
         "이에요",
         "학생이에요 (I'm a student)"
        ],
        [
         "a vowel",
         "예요",
         "의사예요 (I'm a doctor)"
        ]
       ]
      },
      {
       "type": "example",
       "target": "저는 학생이에요.",
       "en": "I am a student.",
       "pron": "jeo-neun hak-saeng-i-e-yo"
      },
      {
       "type": "tip",
       "text": "저 = I (polite). 는 marks the topic: “as for me”."
      }
     ],
     "questions": [
      {
       "type": "mcq",
       "prompt": "ㅎ + ㅏ + ㄴ =",
       "options": [
        "한",
        "학",
        "하"
       ],
       "answer": 0,
       "explanation": "ㅎ+ㅏ = 하, add final ㄴ → 한.",
       "id": "ko_l1_grammar_1_q1",
       "skill": "grammar"
      },
      {
       "type": "mcq",
       "prompt": "저는 학생___.",
       "options": [
        "이에요",
        "예요"
       ],
       "answer": 0,
       "explanation": "학생 ends in a consonant (ㅇ) → 이에요.",
       "id": "ko_l1_grammar_1_q2",
       "skill": "grammar"
      },
      {
       "type": "fill",
       "prompt": "저는 의사___. (I am a doctor)",
       "answers": [
        "예요"
       ],
       "explanation": "의사 ends in a vowel → 예요.",
       "id": "ko_l1_grammar_1_q3",
       "skill": "grammar"
      },
      {
       "type": "order",
       "prompt": "",
       "words": [
        "저는",
        "인도",
        "사람이에요."
       ],
       "explanation": "Topic – noun – 이에요.",
       "translation": "I am Indian.",
       "id": "ko_l1_grammar_1_q4",
       "skill": "grammar"
      },
      {
       "type": "match",
       "prompt": "",
       "pairs": [
        [
         "ㅂ + ㅏ + ㅂ",
         "밥"
        ],
        [
         "ㄱ + ㅡ + ㄹ",
         "글"
        ],
        [
         "ㅇ + ㅗ",
         "오"
        ],
        [
         "ㄱ + ㅏ",
         "가"
        ]
       ],
       "id": "ko_l1_grammar_1_q5",
       "skill": "grammar"
      }
     ]
    }
   ]
