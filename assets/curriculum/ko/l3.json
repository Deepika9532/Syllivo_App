  {
   "id": "ko_l3_grammar",
   "type": "grammar",
   "title": "Connectors and describing nouns",
   "lessons": [
    {
     "id": "ko_l3_grammar_1",
     "title": "Connectors and describing nouns",
     "summary": "-고, -지만, -아서/어서, -(으)니까, -(으)면 and adjective + -(으)ㄴ.",
     "blocks": [
      {
       "type": "table",
       "head": [
        "Connector",
        "Meaning",
        "Example"
       ],
       "rows": [
        [
         "-고",
         "and (then)",
         "밥을 먹고 공부해요."
        ],
        [
         "-지만",
         "but",
         "비싸지만 좋아요."
        ],
        [
         "-아서/어서",
         "because / so (not with commands)",
         "피곤해서 일찍 잤어요."
        ],
        [
         "-(으)니까",
         "because (OK with commands/suggestions)",
         "비가 오니까 우산을 가져가세요."
        ],
        [
         "-(으)면",
         "if / when",
         "시간이 있으면 같이 가요."
        ]
       ]
      },
      {
       "type": "table",
       "head": [
        "Describing a noun",
        "Form",
        "Example"
       ],
       "rows": [
        [
         "adjective (present)",
         "-(으)ㄴ",
         "조용한 카페 (a quiet café)"
        ],
        [
         "verb (present)",
         "-는",
         "제가 읽는 책 (the book I'm reading)"
        ]
       ]
      },
      {
       "type": "tip",
       "text": "-아서/어서 never takes a past tense marker: 피곤했어서 ✗ → 피곤해서 ✓."
      }
     ],
     "questions": [
      {
       "type": "mcq",
       "prompt": "비가 와서 ___.",
       "options": [
        "집에 있었어요",
        "우산을 가져가세요",
        "같이 가요"
       ],
       "answer": 0,
       "explanation": "-아서 cannot be followed by a command or suggestion.",
       "id": "ko_l3_grammar_1_q1",
       "skill": "grammar"
      },
      {
       "type": "fill",
       "prompt": "한국어는 어렵___ 재미있어요. (but)",
       "answers": [
        "지만"
       ],
       "explanation": "-지만 = but.",
       "id": "ko_l3_grammar_1_q2",
       "skill": "grammar"
      },
      {
       "type": "mcq",
       "prompt": "“a quiet café”:",
       "options": [
        "조용한 카페",
        "조용하는 카페",
        "조용하고 카페"
       ],
       "answer": 0,
       "explanation": "Adjective → -(으)ㄴ.",
       "id": "ko_l3_grammar_1_q3",
       "skill": "grammar"
      },
      {
       "type": "correction",
       "prompt": "어제 피곤했어서 일찍 잤어요.",
       "answers": [
        "어제 피곤해서 일찍 잤어요."
       ],
       "explanation": "No past tense before -아서/어서.",
