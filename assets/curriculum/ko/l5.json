  {
   "id": "ko_l5_grammar",
   "type": "grammar",
   "title": "Formal written grammar",
   "lessons": [
    {
     "id": "ko_l5_grammar_1",
     "title": "Formal written grammar",
     "summary": "-에 따르면, nominalisers -(으)ㅁ/-기, -는 반면(에), -(으)ㄹ 뿐만 아니라, -에 비해.",
     "blocks": [
      {
       "type": "table",
       "head": [
        "Pattern",
        "Meaning",
        "Example"
       ],
       "rows": [
        [
         "-에 따르면",
         "according to",
         "조사에 따르면 …"
        ],
        [
         "-(으)ㅁ",
         "nominaliser (written, notices)",
         "회의가 연기됨."
        ],
        [
         "-기",
         "nominaliser (habits, goals)",
         "운동하기가 어렵다."
        ],
        [
         "-는 반면(에)",
         "whereas",
         "가격은 오른 반면 품질은 그대로다."
        ],
        [
         "-(으)ㄹ 뿐만 아니라",
         "not only … but also",
         "싸 뿐만 아니라 → 쌀 뿐만 아니라 품질도 좋다."
        ],
        [
         "-에 비해(서)",
         "compared with",
         "작년에 비해 증가했다."
        ]
       ]
      },
      {
       "type": "tip",
       "text": "News headlines often end in nouns: „물가 상승… 정부 대책 발표“ = prices rise… government announces measures."
      }
     ],
     "questions": [
      {
       "type": "fill",
       "prompt": "조사___ 따르면 응답자의 60%가 찬성했다.",
       "answers": [
        "에"
       ],
       "explanation": "-에 따르면.",
       "id": "ko_l5_grammar_1_q1",
       "skill": "grammar"
      },
      {
       "type": "mcq",
       "prompt": "작년___ 비해 수출이 늘었다.",
       "options": [
        "에",
        "을",
        "이"
       ],
       "answer": 0,
       "explanation": "-에 비해.",
       "id": "ko_l5_grammar_1_q2",
       "skill": "grammar"
      },
      {
       "type": "mcq",
       "prompt": "“not only cheap but also good”:",
       "options": [
        "쌀 뿐만 아니라 좋다",
        "싸는 반면 좋다",
        "싸기 때문에 좋다"
       ],
       "answer": 0,
       "explanation": "-(으)ㄹ 뿐만 아니라.",
       "id": "ko_l5_grammar_1_q3",
       "skill": "grammar"
      },
      {
       "type": "correction",
       "prompt": "도시는 편리하는 반면 시끄럽다.",
       "answers": [
        "도시는 편리한 반면 시끄럽다."
       ],
       "explanation": "Adjectives take -(으)ㄴ 반면.",
       "skill": "grammar",
       "id": "ko_l5_grammar_1_q4"
