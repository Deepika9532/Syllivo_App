  {
   "id": "ko_l2_grammar",
   "type": "grammar",
   "title": "Particles and tenses (polite style)",
   "lessons": [
    {
     "id": "ko_l2_grammar_1",
     "title": "Particles and tenses (polite style)",
     "summary": "은/는, 이/가, 을/를, 에/에서 and -아요/어요, -았/었어요, -(으)ㄹ 거예요.",
     "blocks": [
      {
       "type": "heading",
       "text": "Particles"
      },
      {
       "type": "table",
       "head": [
        "Particle",
        "After consonant / vowel",
        "Function",
        "Example"
       ],
       "rows": [
        [
         "topic",
         "은 / 는",
         "as for …",
         "저는 학생이에요."
        ],
        [
         "subject",
         "이 / 가",
         "new info / who does it",
         "동생이 와요."
        ],
        [
         "object",
         "을 / 를",
         "what is acted on",
         "밥을 먹어요."
        ],
        [
         "place (destination/time)",
         "에",
         "to / at (time)",
         "학교에 가요."
        ],
        [
         "place (action)",
         "에서",
         "at (where it happens)",
         "집에서 공부해요."
        ]
       ]
      },
      {
       "type": "heading",
       "text": "Polite present -아요/어요"
      },
      {
       "type": "table",
       "head": [
        "Rule",
        "Dictionary form",
        "Polite present"
       ],
       "rows": [
        [
         "last vowel ㅏ/ㅗ → 아요",
         "가다",
         "가요"
        ],
        [
         "other vowels → 어요",
         "먹다",
         "먹어요"
        ],
        [
         "하다 → 해요",
         "공부하다",
         "공부해요"
        ]
       ]
      },
      {
       "type": "heading",
       "text": "Past and future"
      },
      {
       "type": "table",
       "head": [
        "Tense",
        "Form",
        "Example"
       ],
       "rows": [
        [
         "Past",
         "-았/었어요, 했어요",
         "먹었어요 (ate)"
        ],
        [
         "Future / plan",
         "-(으)ㄹ 거예요",
         "갈 거예요 (will go)"
        ]
       ]
      }
     ],
     "questions": [
      {
       "type": "mcq",
       "prompt": "저___ 커피를 마셔요.",
       "options": [
        "는",
        "은"
       ],
       "answer": 0,
       "explanation": "저 ends in a vowel → 는.",
       "id": "ko_l2_grammar_1_q1",
       "skill": "grammar"
      },
      {
       "type": "mcq",
       "prompt": "밥___ 먹어요.",
       "options": [
        "을",
        "를"
       ],
       "answer": 0,
       "explanation": "밥 ends in a consonant → 을.",
       "id": "ko_l2_grammar_1_q2",
       "skill": "grammar"
      },
