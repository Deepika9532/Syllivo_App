     "id": "ko_l6_conversation_1",
     "title": "Conversation: a nuanced workplace discussion",
     "summary": "Disagree and negotiate while preserving relationships.",
     "blocks": [
      {
       "type": "dialogue",
       "title": "기획 회의",
       "lines": [
        {
         "speaker": "팀장",
         "target": "이번 프로젝트 일정은 다음 달 말까지로 하는 게 어떨까요?",
         "en": "How about setting the project schedule to the end of next month?"
        },
