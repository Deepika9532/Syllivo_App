  {
   "id": "de_b2_grammar",
   "type": "grammar",
   "title": "The passive voice and advanced connectors",
   "lessons": [
    {
     "id": "de_b2_grammar_1",
     "title": "The passive voice and advanced connectors",
     "summary": "Focus on actions rather than people, and link complex ideas.",
     "blocks": [
      {
       "type": "table",
       "head": [
        "Tense",
        "Passive (werden + participle)"
       ],
       "rows": [
        [
         "Present",
         "Das Haus wird gebaut."
        ],
        [
         "Präteritum",
         "Das Haus wurde gebaut."
        ],
        [
         "Perfect",
         "Das Haus ist gebaut worden."
        ],
        [
         "With modal",
         "Das Haus muss gebaut werden."
        ],
        [
         "State (sein-passive)",
         "Das Haus ist gebaut."
        ]
       ]
      },
      {
       "type": "tip",
       "text": "In the perfect passive the participle of werden is „worden“ (not „geworden“)."
      },
      {
       "type": "table",
       "head": [
        "Connector",
        "Meaning",
        "Example"
       ],
       "rows": [
        [
         "je … desto",
         "the … the",
         "Je mehr man liest, desto besser schreibt man."
        ],
        [
         "indem",
         "by (doing)",
         "Man spart Energie, indem man das Licht ausmacht."
        ],
        [
         "sodass",
         "so that (result)",
         "Es regnete, sodass das Spiel ausfiel."
        ],
        [
         "(an)statt … zu",
         "instead of",
         "Statt zu lernen, schlief er."
        ],
        [
         "während",
         "while / whereas",
         "Während sie arbeitet, kocht er."
        ]
       ]
      }
     ],
     "questions": [
      {
       "type": "fill",
       "prompt": "Die Brücke ___ 1990 gebaut. (Präteritum passive)",
       "answers": [
