   "id": "de_b2_pronunciation",
   "type": "pronunciation",
   "title": "Sentence melody and the glottal stop",
   "lessons": [
    {
     "id": "de_b2_pronunciation_1",
     "title": "Sentence melody and the glottal stop",
     "summary": "Intonation and the small catch before vowels that makes German sound German.",
     "blocks": [
      {
       "type": "text",
       "text": "Statements and W-questions fall at the end. Yes/no questions rise. A glottal stop (a tiny catch) comes before a word or syllable starting with a vowel: be|antworten, ver|eisen (to ice over) vs. verreisen (to go on a trip)."
      },
      {
       "type": "table",
       "head": [
        "Type",
        "Melody",
        "Example"
       ],
       "rows": [
        [
         "Statement",
         "falls ↘",
         "Ich komme morgen."
        ],
        [
         "W-question",
         "falls ↘",
         "Woher kommen Sie?"
        ],
        [
         "Yes/no question",
         "rises ↗",
         "Haben Sie heute Zeit?"
        ]
       ]
      }
     ],
     "questions": [
      {
       "type": "pronounce",
       "audio": "Haben Sie heute Zeit?",
       "translation": "Do you have time today?",
       "prompt": "",
       "skill": "pronunciation",
       "id": "de_b2_pronunciation_1_q1"
      },
      {
       "type": "pronounce",
       "audio": "Woher kommen Sie?",
       "translation": "Where are you from?",
       "prompt": "",
       "skill": "pronunciation",
       "id": "de_b2_pronunciation_1_q2"
      },
      {
       "type": "pronounce",
       "audio": "Wir verreisen morgen.",
       "translation": "We're going away tomorrow.",
       "prompt": "",
       "skill": "pronunciation",
       "id": "de_b2_pronunciation_1_q3"
      },
      {
