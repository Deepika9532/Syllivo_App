       ],
       "explanation": "schlafen takes haben: ich habe geschlafen.",
       "id": "de_a2_writing_1_q2",
       "skill": "writing"
      },
      {
       "type": "mcq",
       "prompt": "Which closing is informal?",
       "options": [
        "Mit freundlichen Grüßen",
        "Liebe Grüße",
        "Sehr geehrte Damen und Herren"
       ],
       "answer": 1,
       "explanation": "Liebe Grüße is for friends.",
       "id": "de_a2_writing_1_q3",
       "skill": "writing"
      }
     ]
    }
