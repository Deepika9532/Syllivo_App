   "id": "de_a2_reading",
   "type": "reading",
   "title": "Reading: an email from Vienna",
   "lessons": [
    {
     "id": "de_a2_reading_1",
     "title": "Reading: an email from Vienna",
     "summary": "An informal email about a trip, using the perfect tense and comparisons.",
     "blocks": [
      {
       "type": "passage",
       "title": "E-Mail von Jonas",
       "target": "Liebe Sara, wie geht es dir? Letzte Woche bin ich nach Wien gefahren. Die Stadt ist schöner als Berlin, finde ich! Am Samstag habe ich das Schloss Schönbrunn besucht und am Abend haben wir in einem Restaurant gegessen. Das Essen war sehr lecker, aber teurer als in Berlin. Nächsten Monat möchte ich dich besuchen. Hast du Zeit? Viele Grüße, Jonas",
       "en": "Dear Sara, how are you? Last week I went to Vienna. The city is more beautiful than Berlin, I think! On Saturday I visited Schönbrunn Palace and in the evening we ate in a restaurant. The food was very tasty but more expensive than in Berlin. Next month I'd like to visit you. Do you have time? Best wishes, Jonas"
      }
     ],
     "questions": [
      {
       "type": "mcq",
       "prompt": "Wohin ist Jonas gefahren?",
       "options": [
        "Berlin",
        "Wien",
        "Salzburg"
       ],
       "answer": 1,
       "explanation": "„bin ich nach Wien gefahren“.",
       "id": "de_a2_reading_1_q1",
       "skill": "reading"
      },
      {
       "type": "mcq",
       "prompt": "Was hat er am Samstag besucht?",
       "options": [
        "ein Museum",
        "das Schloss Schönbrunn",
        "einen Freund"
       ],
       "answer": 1,
       "explanation": "„habe ich das Schloss Schönbrunn besucht“.",
       "id": "de_a2_reading_1_q2",
       "skill": "reading"
      },
      {
       "type": "mcq",
       "prompt": "Wie war das Essen?",
       "options": [
        "billig und schlecht",
        "lecker, aber teurer als in Berlin",
        "nicht lecker"
       ],
       "answer": 1,
       "explanation": "„sehr lecker, aber teurer als in Berlin“.",
       "id": "de_a2_reading_1_q3",
       "skill": "reading"
      },
      {
       "type": "mcq",
       "prompt": "Was möchte Jonas nächsten Monat machen?",
       "options": [
        "Sara besuchen",
        "nach Wien fahren",
        "arbeiten"
       ],
       "answer": 0,
       "explanation": "„möchte ich dich besuchen“.",
       "id": "de_a2_reading_1_q4",
       "skill": "reading"
      }
