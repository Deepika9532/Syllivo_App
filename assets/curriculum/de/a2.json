   "id": "de_a2_pronunciation",
   "type": "pronunciation",
   "title": "Word stress and separable verbs",
   "lessons": [
    {
     "id": "de_a2_pronunciation_1",
     "title": "Word stress and separable verbs",
     "summary": "Where the stress falls changes how natural you sound.",
     "blocks": [
      {
       "type": "text",
       "text": "Most German words stress the first syllable: ARbeit, MORgen. Separable prefixes are stressed: ANrufen, AUFstehen, EINkaufen. Inseparable prefixes (be-, ver-, er-, ge-, ent-) are never stressed: beSUchen, verSTEhen."
      },
      {
       "type": "table",
       "head": [
        "Separable (stressed prefix)",
        "Inseparable (unstressed prefix)"
       ],
       "rows": [
        [
         "ANrufen",
         "beSUchen"
        ],
        [
         "AUFstehen",
         "verSTEhen"
        ],
        [
         "EINkaufen",
         "erZÄHlen"
        ]
       ]
      }
     ],
     "questions": [
      {
       "type": "pronounce",
       "audio": "anrufen",
       "translation": "to call",
       "prompt": "",
       "skill": "pronunciation",
       "id": "de_a2_pronunciation_1_q1"
      },
      {
       "type": "pronounce",
       "audio": "verstehen",
       "translation": "to understand",
       "prompt": "",
       "skill": "pronunciation",
       "id": "de_a2_pronunciation_1_q2"
      },
      {
       "type": "pronounce",
       "audio": "Ich stehe um sieben Uhr auf.",
       "translation": "I get up at seven.",
       "prompt": "",
       "skill": "pronunciation",
       "id": "de_a2_pronunciation_1_q3"
      },
      {
       "type": "mcq",
       "prompt": "Where is the stress in „einkaufen“?",
       "options": [
        "EIN-kaufen",
        "ein-KAU-fen",
        "einkau-FEN"
       ],
       "answer": 0,
       "explanation": "Separable prefixes carry the stress.",
       "id": "de_a2_pronunciation_1_q4",
       "skill": "pronunciation"
      }
     ]
    }
   ]
  },
