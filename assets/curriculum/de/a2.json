  {
   "id": "de_a2_writing",
   "type": "writing",
   "title": "Writing: an informal email",
   "lessons": [
    {
     "id": "de_a2_writing_1",
     "title": "Writing: an informal email",
     "summary": "Greeting, past events in the perfect tense, a question and a closing.",
     "blocks": [
      {
       "type": "table",
       "head": [
        "Part",
        "Informal email"
       ],
       "rows": [
        [
         "Greeting",
         "Liebe Sara, / Lieber Tom, / Hallo Max,"
        ],
        [
         "Opening",
         "Wie geht es dir?"
        ],
        [
         "Past events",
         "Am Wochenende bin ich … gegangen / habe ich … gemacht."
        ],
        [
         "Question",
         "Was hast du gemacht?"
        ],
        [
         "Closing",
         "Viele Grüße / Liebe Grüße, [Name]"
        ]
       ]
      },
      {
       "type": "tip",
       "text": "Perfect tense = haben/sein + past participle at the end. Verbs of movement (gehen, fahren) use sein."
      }
     ],
     "questions": [
      {
       "type": "write",
       "prompt": "Write an email (5–7 sentences) to a friend about your last weekend. Use the perfect tense.",
