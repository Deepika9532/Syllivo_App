  {
   "id": "de_a2_grammar",
   "type": "grammar",
   "title": "Modal verbs, accusative and dative",
   "lessons": [
    {
     "id": "de_a2_grammar_1",
     "title": "Modal verbs, accusative and dative",
     "summary": "Say what you can, must and want to do, and choose the right case.",
     "blocks": [
      {
       "type": "table",
       "head": [
        "",
        "können (can)",
        "müssen (must)",
        "wollen (want)",
        "dürfen (may)"
       ],
       "rows": [
        [
         "ich",
         "kann",
         "muss",
         "will",
         "darf"
        ],
        [
         "du",
         "kannst",
         "musst",
         "willst",
         "darfst"
        ],
        [
         "er/sie/es",
         "kann",
         "muss",
         "will",
         "darf"
        ],
        [
         "wir/sie/Sie",
         "können",
         "müssen",
         "wollen",
         "dürfen"
        ]
       ]
      },
      {
       "type": "text",
       "text": "A modal verb stands in position 2; the main verb goes to the END in the infinitive: Ich muss heute arbeiten."
      },
      {
       "type": "table",
       "head": [
        "Case",
        "masc.",
        "fem.",
        "neut.",
        "plural"
       ],
       "rows": [
        [
         "Nominative (subject)",
         "der",
         "die",
         "das",
         "die"
        ],
        [
         "Accusative (direct object)",
         "den",
         "die",
         "das",
         "die"
        ],
        [
         "Dative (indirect object)",
         "dem",
         "der",
         "dem",
         "den (+n)"
        ]
       ]
      },
      {
       "type": "tip",
       "text": "Always dative after: aus, bei, mit, nach, seit, von, zu. Always accusative after: durch, für, gegen, ohne, um."
      }
     ],
     "questions": [
      {
       "type": "fill",
       "prompt": "Ich ___ heute nicht kommen. (können)",
       "answers": [
        "kann"
       ],
       "explanation": "ich kann; the infinitive kommen goes to the end.",
       "id": "de_a2_grammar_1_q1",
       "skill": "grammar"
      },
      {
       "type": "mcq",
       "prompt": "Ich sehe ___ Mann.",
       "options": [
        "der",
        "den",
        "dem"
       ],
       "answer": 1,
       "explanation": "sehen takes a direct object → accusative den.",
       "id": "de_a2_grammar_1_q2",
       "skill": "grammar"
      },
      {
       "type": "mcq",
       "prompt": "Ich fahre mit ___ Bus.",
       "options": [
        "der",
        "den",
        "dem"
       ],
       "answer": 2,
       "explanation": "mit + dative: dem Bus.",
       "id": "de_a2_grammar_1_q3",
       "skill": "grammar"
      },
      {
       "type": "correction",
       "prompt": "Ich muss morgen arbeite.",
       "answers": [
        "Ich muss morgen arbeiten."
       ],
       "explanation": "After a modal verb: infinitive (arbeiten) at the end.",
       "skill": "grammar",
       "id": "de_a2_grammar_1_q4"
      },
      {
       "type": "order",
       "prompt": "",
       "words": [
        "Kannst",
        "du",
        "mir",
        "helfen?"
       ],
       "translation": "Can you help me?",
       "id": "de_a2_grammar_1_q5",
       "skill": "grammar"
      }
     ]
    }
   ]
  },
