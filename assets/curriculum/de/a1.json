  {
   "id": "de_a1_writing",
   "type": "writing",
   "title": "Writing: introduce yourself",
   "lessons": [
    {
     "id": "de_a1_writing_1",
     "title": "Writing: introduce yourself",
     "summary": "Build a short self-introduction from fixed sentence patterns.",
     "blocks": [
      {
       "type": "text",
       "text": "Use these patterns and replace the words in brackets."
      },
      {
       "type": "example",
       "target": "Ich heiße [Name].",
       "en": "My name is …"
      },
      {
       "type": "example",
       "target": "Ich komme aus [Land].",
       "en": "I come from …"
      },
      {
       "type": "example",
       "target": "Ich wohne in [Stadt].",
       "en": "I live in …"
      },
      {
       "type": "example",
       "target": "Ich bin Student / Studentin.",
       "en": "I am a student (m / f)."
      },
      {
       "type": "example",
       "target": "In meiner Freizeit spiele ich gern [Hobby].",
       "en": "In my free time I like playing …"
      },
      {
       "type": "tip",
       "text": "Jobs have a masculine and feminine form: Lehrer / Lehrerin, Arzt / Ärztin. No article: Ich bin Lehrer."
      }
     ],
     "questions": [
      {
       "type": "write",
       "prompt": "Write 3–5 sentences about yourself: your name, where you come from, where you live and a hobby.",
       "minWords": 15,
       "keywords": [
        "ich",
        "heiße|bin",
        "komme|wohne"
       ],
       "sample": "Ich heiße Ravi. Ich komme aus Indien und wohne in Hyderabad. Ich bin Student. In meiner Freizeit spiele ich gern Cricket.",
       "skill": "writing",
       "id": "de_a1_writing_1_q1"
      },
      {
       "type": "fill",
       "prompt": "Ich ___ aus Indien. (kommen)",
       "answers": [
        "komme"
       ],
       "explanation": "ich komme.",
       "id": "de_a1_writing_1_q2",
       "skill": "writing"
      },
      {
       "type": "order",
       "prompt": "",
       "words": [
        "Ich",
        "wohne",
        "in",
        "Hyderabad."
       ],
       "explanation": "Subject – verb – place.",
       "translation": "I live in Hyderabad.",
       "id": "de_a1_writing_1_q3",
       "skill": "writing"
      },
      {
       "type": "mcq",
       "prompt": "A female doctor says:",
       "options": [
        "Ich bin ein Arzt.",
        "Ich bin Ärztin.",
        "Ich bin die Ärztin."
       ],
       "answer": 1,
       "explanation": "No article with professions, and the female form ends in -in.",
       "id": "de_a1_writing_1_q4",
       "skill": "writing"
      }
     ]
    }
   ]
  },
