  {
   "id": "de_a1_pronunciation",
   "type": "pronunciation",
   "title": "German sounds: umlauts, ch, ß, ei and ie",
   "lessons": [
    {
     "id": "de_a1_pronunciation_1",
     "title": "German sounds: umlauts, ch, ß, ei and ie",
     "summary": "The sounds English speakers find hardest, with a reliable rule for each.",
     "blocks": [
      {
       "type": "table",
       "head": [
        "Spelling",
        "How to say it",
        "Example"
       ],
       "rows": [
        [
         "ä",
         "like e in “bed”",
         "Mädchen (girl)"
        ],
        [
         "ö",
         "say “e” with rounded lips",
         "schön (beautiful)"
        ],
        [
         "ü",
         "say “ee” with rounded lips",
         "Brücke (bridge)"
        ],
        [
         "ch after e, i",
         "soft hiss, like a whispered “h”",
         "ich (I)"
        ],
        [
         "ch after a, o, u",
         "from the throat, like Scottish “loch”",
         "Buch (book)"
        ],
        [
         "ß / ss",
         "a sharp s",
         "Straße (street)"
        ],
        [
         "ei",
         "like “eye”",
         "Wein (wine)"
        ],
        [
         "ie",
         "like “ee”",
         "Wien (Vienna)"
        ],
        [
         "w",
         "like English v",
         "Wasser (water)"
        ],
        [
         "v",
         "usually like f",
         "Vater (father)"
        ],
        [
         "z",
         "ts",
         "Zeit (time)"
        ]
       ]
      },
      {
       "type": "tip",
       "text": "Trick for ei / ie: say the SECOND letter’s English name. ei → “eye” (i), ie → “ee” (e)."
      }
     ],
     "questions": [
