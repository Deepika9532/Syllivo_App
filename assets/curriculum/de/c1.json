  {
   "id": "de_c1_grammar",
   "type": "grammar",
   "title": "Nominal style and indirect speech",
   "lessons": [
    {
     "id": "de_c1_grammar_1",
     "title": "Nominal style and indirect speech",
     "summary": "Academic German prefers nouns; reported speech uses Konjunktiv I.",
     "blocks": [
      {
       "type": "heading",
       "text": "Nominal style"
      },
      {
       "type": "table",
       "head": [
        "Verbal style",
        "Nominal style"
       ],
       "rows": [
        [
         "weil die Preise steigen",
         "aufgrund steigender Preise"
        ],
        [
         "nachdem das Projekt abgeschlossen wurde",
         "nach Abschluss des Projekts"
        ],
        [
         "wenn man das Gesetz ändert",
         "bei einer Änderung des Gesetzes"
        ],
        [
         "obwohl es Kritik gab",
         "trotz der Kritik"
        ]
       ]
      },
      {
       "type": "heading",
       "text": "Konjunktiv I (indirect speech)"
      },
      {
       "type": "table",
       "head": [
        "Verb",
        "er / sie / es",
        "Note"
       ],
       "rows": [
        [
         "sein",
         "sei",
         "sie seien (plural)"
        ],
        [
         "haben",
         "habe",
         "plural uses hätten (habe = indicative)"
        ],
        [
         "können",
         "könne",
         ""
        ],
        [
         "werden",
         "werde",
         "future in reported speech"
        ],
        [
         "kommen",
         "komme",
         "stem + e"
        ]
       ]
      },
      {
       "type": "example",
       "target": "Die Ministerin sagte, sie sei mit dem Ergebnis zufrieden.",
       "en": "The minister said she was satisfied with the result."
      },
      {
       "type": "tip",
       "text": "Konjunktiv I signals that the writer is reporting, not claiming. It is standard in news and academic texts."
      }
     ],
     "questions": [
      {
       "type": "fill",
       "prompt": "Der Minister sagte, er ___ zufrieden. (sein)",
       "answers": [
        "sei"
       ],
       "explanation": "Konjunktiv I of sein: sei.",
       "id": "de_c1_grammar_1_q1",
       "skill": "grammar"
      },
      {
       "type": "mcq",
       "prompt": "aufgrund ___ Preise",
       "options": [
        "steigender",
        "steigende",
        "steigenden"
       ],
       "answer": 0,
       "explanation": "Genitive plural without article: strong ending -er.",
       "id": "de_c1_grammar_1_q2",
       "skill": "grammar"
      },
      {
       "type": "mcq",
       "prompt": "Nominal form of „nachdem das Projekt abgeschlossen wurde“:",
       "options": [
        "nach Abschluss des Projekts",
        "nach dem Abschluss der Projekt",
        "nach den Abschluss des Projekts"
       ],
       "answer": 0,
       "explanation": "nach + dative; des Projekts (genitive).",
       "id": "de_c1_grammar_1_q3",
       "skill": "grammar"
      },
      {
       "type": "correction",
       "prompt": "Laut dem Bericht, die Zahl ist gestiegen.",
       "answers": [
        "Laut dem Bericht ist die Zahl gestiegen."
       ],
       "explanation": "„Laut dem Bericht“ fills position 1; the verb follows directly, no comma.",
       "skill": "grammar",
       "id": "de_c1_grammar_1_q4"
      },
      {
       "type": "fill",
       "prompt": "Sie behauptete, sie ___ keine Zeit gehabt. (haben)",
       "answers": [
        "habe"
       ],
       "explanation": "Konjunktiv I: sie habe.",
       "id": "de_c1_grammar_1_q5",
       "skill": "grammar"
      }
     ]
    }
   ]
