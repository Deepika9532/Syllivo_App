   "lessons": [
    {
     "id": "de_c1_pronunciation_1",
     "title": "Fluency: consonant clusters and compound stress",
     "summary": "Long words and dense consonants without hesitation.",
     "blocks": [
      {
       "type": "text",
       "text": "Compounds stress the FIRST part: BAHNhof, KRANkenversicherung, HAUSaufgabe. Practise clusters slowly, then at normal speed: Herbst (autumn), du sprichst, der Strumpf (sock)."
      },
      {
       "type": "tip",
       "text": "Break a long compound into its parts first: Kranken-ver-sicherung → then join them."
      }
     ],
