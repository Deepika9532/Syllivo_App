  {
   "id": "de_c1_reading",
   "type": "reading",
   "title": "Reading: a research abstract",
   "lessons": [
    {
     "id": "de_c1_reading_1",
     "title": "Reading: a research abstract",
     "summary": "Academic register, hedging and reported findings.",
     "blocks": [
      {
       "type": "passage",
       "title": "Mehrsprachigkeit und kognitive Flexibilität",
       "target": "Die vorliegende Untersuchung geht der Frage nach, inwiefern Mehrsprachigkeit die kognitive Flexibilität von Kindern beeinflusst. Hierzu wurden 120 Grundschulkinder mit unterschiedlichem sprachlichem Hintergrund getestet. Die Ergebnisse deuten darauf hin, dass mehrsprachige Kinder bei Aufgaben, die einen schnellen Wechsel zwischen Regeln erfordern, tendenziell besser abschneiden. Allerdings lassen sich aufgrund der geringen Stichprobengröße keine allgemeingültigen Schlussfolgerungen ziehen. Weitere Studien seien notwendig, so die Autorinnen.",
       "en": "This study examines to what extent multilingualism influences children's cognitive flexibility. For this purpose, 120 primary school children with different language backgrounds were tested. The results suggest that multilingual children tend to perform better on tasks requiring a quick switch between rules. However, owing to the small sample size, no generally valid conclusions can be drawn. Further studies are necessary, according to the authors."
      },
      {
       "type": "tip",
       "text": "Hedging language — deuten darauf hin, tendenziell, lassen sich keine … ziehen — shows how certain the authors are."
      }
     ],
     "questions": [
      {
       "type": "mcq",
       "prompt": "Was wird untersucht?",
       "options": [
        "Einfluss von Mehrsprachigkeit auf kognitive Flexibilität",
        "Schulnoten mehrsprachiger Kinder",
        "Lehrmethoden in Grundschulen"
       ],
       "answer": 0,
       "explanation": "„geht der Frage nach, inwiefern …“.",
       "id": "de_c1_reading_1_q1",
       "skill": "reading"
      },
      {
       "type": "mcq",
       "prompt": "Was schränkt die Aussagekraft ein?",
       "options": [
        "die geringe Stichprobengröße",
        "das Alter der Autorinnen",
        "fehlende Ergebnisse"
       ],
       "answer": 0,
       "explanation": "„aufgrund der geringen Stichprobengröße“.",
       "id": "de_c1_reading_1_q2",
       "skill": "reading"
      },
      {
       "type": "mcq",
       "prompt": "Warum steht „seien“ im Konjunktiv I?",
       "options": [
        "Es ist indirekte Rede.",
        "Es ist eine Bitte.",
        "Es ist Vergangenheit."
       ],
       "answer": 0,
       "explanation": "The authors' view is reported.",
       "id": "de_c1_reading_1_q3",
       "skill": "reading"
      },
      {
       "type": "mcq",
       "prompt": "„tendenziell“ means:",
       "options": [
        "tending to / on the whole",
        "definitely",
        "never"
       ],
       "answer": 0,
       "explanation": "A hedge: a tendency, not a certainty.",
       "id": "de_c1_reading_1_q4",
       "skill": "reading"
      }
     ]
    }
   ]
  },
  {
   "id": "de_c1_writing",
   "type": "writing",
   "title": "Writing: summarising an academic text",
   "lessons": [
    {
     "id": "de_c1_writing_1",
     "title": "Writing: summarising an academic text",
     "summary": "Neutral, concise summaries with reporting verbs.",
     "blocks": [
      {
       "type": "table",
       "head": [
        "Function",
        "Phrase"
       ],
       "rows": [
        [
         "Topic",
         "Der Text befasst sich mit … / Im Mittelpunkt steht …"
        ],
        [
         "Author's position",
         "Die Autorin vertritt die These, dass …"
        ],
        [
         "Method",
         "Hierzu wurden … untersucht."
        ],
        [
         "Result",
         "Die Ergebnisse zeigen / deuten darauf hin, dass …"
        ],
        [
         "Limitation",
         "Einschränkend ist anzumerken, dass …"
        ],
        [
         "Conclusion",
         "Zusammenfassend lässt sich festhalten, dass …"
        ]
       ]
      },
      {
       "type": "tip",
       "text": "A summary reports — it does not judge. Use Konjunktiv I or reporting verbs, and keep your own opinion out."
      }
     ],
     "questions": [
      {
       "type": "write",
       "prompt": "Summarise the research abstract from the Reading module in 80+ words, in neutral academic German.",
       "minWords": 80,
       "keywords": [
        "befasst|untersucht|thema|mittelpunkt",
        "ergebnis",
        "zusammenfassend|insgesamt|einschränkend"
       ],
       "sample": "Der Text befasst sich mit der Frage, ob Mehrsprachigkeit die kognitive Flexibilität von Kindern beeinflusst. Hierzu wurden 120 Grundschulkinder mit unterschiedlichem sprachlichem Hintergrund getestet. Die Ergebnisse deuten darauf hin, dass mehrsprachige Kinder bei Aufgaben mit Regelwechseln tendenziell besser abschneiden. Einschränkend ist anzumerken, dass die Stichprobe klein war. Zusammenfassend lässt sich festhalten, dass weitere Studien notwendig sind, um die Befunde zu bestätigen.",
       "skill": "writing",
       "id": "de_c1_writing_1_q1"
      },
      {
       "type": "fill",
       "prompt": "Zusammenfassend lässt sich ___, dass … (state)",
       "answers": [
        "festhalten",
        "sagen",
        "feststellen"
       ],
       "explanation": "Zusammenfassend lässt sich festhalten …",
       "id": "de_c1_writing_1_q2",
       "skill": "writing"
      },
      {
       "type": "mcq",
       "prompt": "Which sentence is neutral?",
       "options": [
        "Die Autorin vertritt die These, dass …",
        "Die Autorin hat völlig recht, dass …",
        "Leider glaubt die Autorin, dass …"
       ],
       "answer": 0,
       "explanation": "Report without evaluating.",
       "id": "de_c1_writing_1_q3",
       "skill": "writing"
      }
     ]
    }
   ]
  },
