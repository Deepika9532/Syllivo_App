   "lessons": [
    {
     "id": "de_b1_grammar_1",
     "title": "Subordinate clauses, relative clauses, Präteritum and Konjunktiv II",
     "summary": "The structures that let you explain, connect and speculate.",
     "blocks": [
      {
       "type": "heading",
       "text": "Subordinate clauses"
      },
      {
       "type": "text",
       "text": "After weil (because), dass (that), obwohl (although), wenn (if/when), ob (whether) the conjugated verb goes to the END."
      },
      {
       "type": "example",
       "target": "Ich lerne Deutsch, weil ich in Berlin arbeiten möchte.",
       "en": "I'm learning German because I want to work in Berlin."
      },
      {
       "type": "heading",
       "text": "Relative clauses"
      },
      {
       "type": "table",
       "head": [
        "",
        "masc.",
        "fem.",
        "neut.",
        "plural"
       ],
       "rows": [
        [
         "Nominative",
         "der",
         "die",
         "das",
         "die"
        ],
        [
         "Accusative",
         "den",
         "die",
         "das",
         "die"
        ],
        [
         "Dative",
         "dem",
         "der",
         "dem",
         "denen"
        ]
       ]
      },
      {
       "type": "example",
       "target": "Das ist der Mann, den ich gestern gesehen habe.",
       "en": "That's the man (whom) I saw yesterday."
      },
      {
       "type": "heading",
       "text": "Präteritum (simple past) — mainly in writing and for sein, haben, modals"
      },
      {
       "type": "table",
       "head": [
        "Infinitive",
        "ich / er"
       ],
       "rows": [
        [
         "sein",
         "war"
        ],
        [
         "haben",
         "hatte"
        ],
        [
         "gehen",
         "ging"
        ],
        [
         "kommen",
         "kam"
        ],
        [
         "machen",
         "machte"
        ],
        [
         "können",
         "konnte"
        ]
       ]
      },
      {
       "type": "heading",
       "text": "Konjunktiv II — wishes, polite requests, hypotheses"
      },
      {
       "type": "table",
       "head": [
        "Use",
        "Form",
        "Example"
       ],
       "rows": [
        [
         "most verbs",
         "würde + infinitive",
         "Ich würde gern reisen."
        ],
        [
         "haben",
         "hätte",
         "Wenn ich Zeit hätte, …"
        ],
        [
         "sein",
