     "summary": "Typical questions and strong answers.",
     "blocks": [
      {
       "type": "dialogue",
       "title": "Im Vorstellungsgespräch",
       "lines": [
        {
         "speaker": "Interviewer",
         "target": "Erzählen Sie etwas über sich.",
         "en": "Tell me about yourself."
        },
        {
         "speaker": "Bewerberin",
         "target": "Ich habe Informatik studiert und arbeite seit drei Jahren als Entwicklerin.",
         "en": "I studied computer science and have worked as a developer for three years."
        },
        {
         "speaker": "Interviewer",
         "target": "Warum möchten Sie bei uns arbeiten?",
         "en": "Why do you want to work for us?"
        },
        {
         "speaker": "Bewerberin",
         "target": "Weil Ihre Firma innovative Projekte macht und ich mich weiterentwickeln möchte.",
         "en": "Because your company does innovative projects and I want to develop further."
        },
        {
         "speaker": "Interviewer",
         "target": "Was sind Ihre Stärken?",
         "en": "What are your strengths?"
        },
        {
         "speaker": "Bewerberin",
         "target": "Ich bin zuverlässig und arbeite gern im Team.",
         "en": "I'm reliable and like working in a team."
        }
       ]
      }
     ],
     "questions": [
